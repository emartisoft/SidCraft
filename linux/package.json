{
  "name": "sidcraft-linux",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Build, install and uninstall the SidCraft Linux AppImage with Bun.",
  "scripts": {
    "appimage": "bun src/cli.ts",
    "build": "bun src/cli.ts build",
    "setup": "bun src/cli.ts install",
    "remove": "bun src/cli.ts uninstall",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  }
}
